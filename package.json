{
  "name": "takotrace",
  "version": "0.0.4",
  "description": "Local-first session inspector and execution tracer for Codex and Claude agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhaofinger/takotrace"
  },
  "homepage": "https://github.com/zhaofinger/takotrace#readme",
  "bugs": {
    "url": "https://github.com/zhaofinger/takotrace/issues"
  },
  "keywords": [
    "ai-agent",
    "agent-tracing",
    "claude-code",
    "codex",
    "developer-tools",
    "local-first",
    "mcp",
    "observability",
    "session-inspector",
    "subagent"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "takotrace": "dist/cli.js"
  },
  "files": [
    "assets",
    "dist",
    "DEVELOPMENT.md",
    "NOTICE",
    "PRODUCT.md",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "TECHNICAL_DESIGN.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "concurrently --kill-others --names server,web --prefix-colors magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/cli.ts --no-open",
    "dev:web": "vite",
    "prepublishOnly": "npm run test && npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.250",
    "highlight.js": "^11.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
